{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if .IsHome -}}
  {{- $pages = where $pctx.RegularPages "Section" "posts" -}}
  {{- if eq (len $pages) 0 -}}
    {{- $pages = where $pctx.RegularPages "Section" "in" site.Params.mainSections -}}
  {{- end -}}
  {{- if eq (len $pages) 0 -}}
    {{- $pages = $pctx.RegularPages -}}
  {{- end -}}
{{- else if .IsSection -}}
  {{- $pages = $pctx.RegularPages -}}
{{- else -}}
  {{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $pages = where $pages "Title" "!=" "" -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ printf "<?xml-stylesheet type=\"text/xsl\" href=%q ?>" ("rss-style.xsl" | relURL) | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent dispatches {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Lang }}</language>{{ with .Site.Params.author.email }}
    <managingEditor>{{ . }}{{ with $.Site.Params.author.name }} ({{ . }}){{ end }}</managingEditor>{{ end }}{{ with .Site.Params.author.email }}
    <webMaster>{{ . }}{{ with $.Site.Params.author.name }} ({{ . }}){{ end }}</webMaster>{{ end }}{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}
      {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{ end }}
    {{- $baseURL := strings.TrimSuffix "/" $.Site.BaseURL -}}
    {{ range $pages }}
    {{- $content := .Content -}}
    {{- /* Make relative links and image sources absolute for external RSS readers */ -}}
    {{- $content = $content | replaceRE `src="(/[^"]*)"` (printf `src="%s$1"` $baseURL) -}}
    {{- $content = $content | replaceRE `src='(/[^']*)'` (printf `src='%s$1'` $baseURL) -}}
    {{- $content = $content | replaceRE `href="(/[^"]*)"` (printf `href="%s$1"` $baseURL) -}}
    {{- $content = $content | replaceRE `href='(/[^']*)'` (printf `href='%s$1'` $baseURL) -}}
    {{- $cleanContent := replace $content "]]>" "]]&gt;" -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with .Site.Params.author.email }}<author>{{ . }}{{ with $.Site.Params.author.name }} ({{ . }}){{ end }}</author>{{ end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ (printf "<![CDATA[%s]]>" $cleanContent) | safeHTML }}</description>
      <content:encoded>{{ (printf "<![CDATA[%s]]>" $cleanContent) | safeHTML }}</content:encoded>
      {{ range .Params.tags }}
      <category>{{ . }}</category>
      {{ end }}
      {{ with .Params.image }}
        {{ $imgURL := . }}
        {{ if not (or (hasPrefix $imgURL "http://") (hasPrefix $imgURL "https://")) }}
          {{ $imgURL = printf "%s/%s" $baseURL (strings.TrimPrefix "/" $imgURL) }}
        {{ end }}
        <media:content url="{{ $imgURL }}" medium="image" />
      {{ end }}
    </item>
    {{ end }}
  </channel>
</rss>
